// fastfetch look for Ptyxis (Tokyo Night palette) - installed by 36-terminal-look.sh
// Icons need a Nerd Font (JetBrainsMono Nerd Font). Try it: fastfetch   Full option list: fastfetch --help config
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "debian",
    "color": { "1": "magenta", "2": "blue" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    "break",
    { "type": "os",       "key": "  ", "keyColor": "magenta", "format": "{pretty-name}" },
    { "type": "kernel",   "key": "  ",    "keyColor": "magenta" },
    { "type": "uptime",   "key": "  󰅐",    "keyColor": "magenta" },
    { "type": "command",  "key": "  󰧓",    "keyColor": "magenta",
      "text": "d=$(stat -c %W /); [ \"$d\" -gt 0 ] || d=$(stat -c %Y /var/log/installer); echo \"installed $(( ($(date +%s)-d)/86400 )) days ago, $(date -d @$d '+%b %-d %Y')\"" },
    "break",
    { "type": "host",     "key": "  󰌢",    "keyColor": "blue" },
    { "type": "cpu",      "key": "  ",    "keyColor": "blue", "temp": true },
    { "type": "gpu",      "key": "  󰢮",    "keyColor": "blue" },
    { "type": "memory",   "key": "  󰍛",    "keyColor": "blue" },
    { "type": "disk",     "key": "  󰋊",    "keyColor": "blue", "folders": "/" },
    { "type": "display",  "key": "  󰍹",    "keyColor": "blue" },
    { "type": "battery",  "key": "  󰁹",    "keyColor": "blue" },
    "break",
    { "type": "de",       "key": "  ",    "keyColor": "cyan" },
    { "type": "wm",       "key": "  󱂬",    "keyColor": "cyan" },
    { "type": "shell",    "key": "  󰆍",    "keyColor": "cyan" },
    { "type": "terminal", "key": "  ",    "keyColor": "cyan" },
    { "type": "packages", "key": "  󰏗",    "keyColor": "cyan" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
