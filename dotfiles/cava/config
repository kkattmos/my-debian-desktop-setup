## cava audio visualizer, Tokyo Night colours - installed by 36-terminal-look.sh
## Run it in a Ptyxis tab or a small tiled window: cava   (q quits, arrows change sensitivity/bars)
## All options: /usr/share/doc/cava/examples/config (or man cava)

[general]
framerate = 60
bar_width = 2
bar_spacing = 1
sleep_timer = 5

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom

[color]
# bottom -> top: blue, purple, pink, orange (matches the Tokyo Night palette and the wallpaper sky)
gradient = 1
gradient_count = 4
gradient_color_1 = '#7aa2f7'
gradient_color_2 = '#bb9af7'
gradient_color_3 = '#f7768e'
gradient_color_4 = '#ff9e64'

[smoothing]
noise_reduction = 77
