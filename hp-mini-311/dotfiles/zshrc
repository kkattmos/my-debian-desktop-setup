# ~/.zshrc (HP Mini 311, Debian 12 i386) - plain zsh + Powerlevel10k + Debian-packaged plugins.
# Same as the Dell's zshrc except: fastfetch in xfce4-terminal, fzf 0.38 scripts, exa instead of eza,
# svc knows seafile + blur (no Docker/PhotoPrism on 32-bit). Reload with: exec zsh
# Prompt look: run `p10k configure` (interactive wizard, writes ~/.p10k.zsh).

# Ly starts the X session from a text console, so TERM=linux can leak into the desktop.
# In a graphical terminal that means 8 colours + no Unicode for p10k, nvim, less ...
[[ $TERM == linux && $TTY == /dev/pts/* && -n $WAYLAND_DISPLAY$DISPLAY ]] && export TERM=xterm-256color

# System info at the top of each new xfce4-terminal tab (not in nested shells or nvim :terminal,
# whose parent process is a shell or nvim). Must stay above the instant prompt. 0 = off.
FASTFETCH_ON_START=1
[[ $FASTFETCH_ON_START == 1 && $(ps -o comm= -p $PPID 2>/dev/null) == xfce4-terminal ]] && (( $+commands[fastfetch] )) && fastfetch

# Powerlevel10k instant prompt - keep this near the top. Anything that asks for input
# (password prompts, [y/n]) must go ABOVE this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------- PATH ----------
typeset -U path
path=(~/.local/bin ~/.local/opt/nvim/bin ~/.cargo/bin $path /usr/games)
export EDITOR=nvim VISUAL=nvim

# ---------- history ----------
HISTFILE=~/.zsh_history HISTSIZE=50000 SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks extended_history

# ---------- behaviour ----------
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments no_beep
bindkey -e                                  # emacs keys; use `bindkey -v` for vi mode
autoload -Uz compinit && compinit -d ~/.cache/zcompdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---------- plugins (Debian packages) ----------
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# Debian 12's fzf (0.38) has no `fzf --zsh`; it ships the same scripts here. Ctrl-R, Ctrl-T, Alt-C
source /usr/share/doc/fzf/examples/key-bindings.zsh
source /usr/share/doc/fzf/examples/completion.zsh
eval "$(zoxide init zsh)"                                  # `z proj` jumps to frecent dirs

# ---------- prompt: Powerlevel10k (git clone by m30-user.sh, no oh-my-zsh) ----------
# No ~/.p10k.zsh yet -> the configuration wizard starts by itself. Rerun it any time: p10k configure
[[ -r ~/.local/share/powerlevel10k/powerlevel10k.zsh-theme ]] && source ~/.local/share/powerlevel10k/powerlevel10k.zsh-theme
[[ -r ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ---------- aliases ----------
# exa (Debian 12; eza has no 32-bit build) - same options as the Dell's eza aliases
alias ls='exa --group-directories-first --icons' ll='ls -l --git' la='ll -a' tree='ls --tree'
alias cat='batcat --paging=never' fd='fdfind' v='nvim' lg='lazygit'
alias update='sudo apt update && sudo apt full-upgrade && sudo apt autoremove --purge'
alias snaps='sudo snapper -c root list'

# ---------- git shortcuts (same names as oh-my-zsh's git plugin) ----------
alias g='git' gst='git status' gss='git status --short'
alias ga='git add' gaa='git add --all'
alias gc='git commit --verbose' gca='git commit --verbose --all' gcmsg='git commit --message'
alias gco='git checkout' gcb='git checkout -b' gsw='git switch' gswc='git switch --create'
alias gb='git branch' gba='git branch --all'
alias gd='git diff' gds='git diff --staged'
alias gf='git fetch' gl='git pull' gp='git push' gpf='git push --force-with-lease'
alias gpsup='git push --set-upstream origin "$(git branch --show-current)"'
alias glog='git log --oneline --decorate --graph' grb='git rebase' grs='git restore' grh='git reset'
alias gsta='git stash push' gstp='git stash pop' gcl='git clone --recurse-submodules'

# ---------- on/off: svc seafile|blur on|off|status ----------
# blur = picom (frosted glass behind the terminal + panel). Off = xfwm4's own compositor:
# still see-through, no blur, lighter on the Atom/ION.
svc() {
  local name=$1 action=${2:-status} auto=~/.config/autostart/picom.desktop
  case "$name:$action" in
    seafile:on)      systemctl --user start seafile ;;
    seafile:off)     systemctl --user stop seafile ;;
    seafile:status)  systemctl --user is-active seafile; seaf-cli status ;;
    blur:on)
      sed -i 's/^Hidden=true$/Hidden=false/' $auto
      xfconf-query -c xfwm4 -p /general/use_compositing -s false
      pkill -x picom; sleep 0.5
      (picom --experimental-backends --config ~/.config/picom/picom.conf >/dev/null 2>&1 &!) ;;
    blur:off)
      sed -i 's/^Hidden=false$/Hidden=true/' $auto
      pkill -x picom; sleep 0.5
      xfconf-query -c xfwm4 -p /general/use_compositing -s true ;;
    blur:status)     pgrep -x picom >/dev/null && echo "on (picom)" || echo "off (xfwm4 compositor: $(xfconf-query -c xfwm4 -p /general/use_compositing))" ;;
    *) echo "usage: svc seafile|blur on|off|status"; return 1 ;;
  esac
}

# must be last
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
